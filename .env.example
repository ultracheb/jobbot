# Токен ад @BotFather у Telegram (/newbot)
TELEGRAM_TOKEN=

# Неабавязкова: Telegram ID, каму дазволена карыстацца ботам (праз коску).
# Свой ID можна даведацца ў @userinfobot. Пуста = можа кожны.
ALLOWED_USERS=

# Неабавязкова: бясплатны ключ Jooble https://jooble.org/api/about
JOOBLE_KEY=

# Неабавязкова
TZ_NAME=Europe/Prague
DB_PATH=jobbot.db
